#!/usr/bin/env bash
# Majordomus supervision is mandatory in this repository: a commit requires a healthy, wired .ai/
# layer (policy enforcement doctor-on-commit), a current catalogue and no whitespace errors.
set -euo pipefail
if ! command -v majordomus >/dev/null 2>&1; then
  echo "pre-commit: majordomus is required (https://majordomus.dev)" >&2
  exit 1
fi
majordomus worktree guard --quiet || exit $?
git diff --cached --check || exit $?
MAJORDOMUS_DOCTOR_CONTEXT=commit majordomus doctor || exit $?
# The catalogue check reads the working tree, so the working tree must be what is committed for
# the paths it derives from: content and the regenerated catalogue are staged together.
if ! git diff --quiet -- content data static/data templates static/js; then
  echo "pre-commit: unstaged changes in content/, data/ or static/data/; stage the content and" >&2
  echo "            the regenerated catalogue (npm run derive) together" >&2
  exit 1
fi
python3 scripts/catalog.py --check || exit $?
python3 scripts/i18n.py --check || exit $?
python3 scripts/images.py --check || exit $?
python3 scripts/check-components.py || exit $?
