{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://korczis.github.io/sonic-playground/schema/spotify-manifest.v1.json",
 "title": "The map of the Spotify history (data/spotify/manifest.json)",
 "description": "Every record kind, table and index, with its schema, key, foreign keys and row count: the entry point for integration, indexing, import and joining.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "description",
  "sources",
  "records",
  "tables",
  "index",
  "counts",
  "private"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "spotify-manifest/v1"
   ]
  },
  "description": {
   "type": "string"
  },
  "sources": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "records": {
   "type": "object"
  },
  "tables": {
   "type": "object",
   "required": [
    "tracks",
    "playlists",
    "memberships",
    "artists",
    "albums"
   ]
  },
  "index": {
   "type": "object"
  },
  "counts": {
   "type": "object",
   "required": [
    "tracks",
    "playlists",
    "memberships"
   ]
  },
  "private": {
   "type": "string"
  },
  "schemas": {
   "type": "object"
  }
 }
}
