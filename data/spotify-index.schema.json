{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://korczis.github.io/sonic-playground/schema/spotify-index.v1.json",
 "title": "What the history says per review (data/spotify/index.json)",
 "description": "Read by templates/page.html (the review's Spotify row and track link) and templates/index.html (On repeat). Derived by scripts/spotify_history.py.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "songs",
  "liked",
  "reviewed",
  "playlists",
  "reviews",
  "top"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "spotify-index/v1"
   ]
  },
  "songs": {
   "type": "integer"
  },
  "liked": {
   "type": "integer"
  },
  "reviewed": {
   "type": "integer"
  },
  "playlists": {
   "type": "integer"
  },
  "reviews": {
   "type": "object",
   "description": "Keyed by the review's file name (content/<file>)."
  },
  "top": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "range",
     "rank",
     "read",
     "record",
     "title",
     "artists"
    ],
    "properties": {
     "range": {
      "type": "string",
      "enum": [
       "month",
       "half-year",
       "all-time"
      ]
     },
     "rank": {
      "type": "integer"
     },
     "read": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "record": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "title": {
      "type": "string"
     },
     "artists": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "review": {
      "type": "string",
      "pattern": "\\.md$"
     }
    }
   }
  }
 },
 "$defs": {
  "review": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "records",
    "liked",
    "yearbooks",
    "playlists"
   ],
   "properties": {
    "records": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     }
    },
    "liked": {
     "type": "boolean"
    },
    "yearbooks": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "playlists": {
     "type": "integer"
    },
    "track": {
     "type": "string",
     "pattern": "^[0-9A-Za-z]{22}$"
    }
   }
  }
 }
}
