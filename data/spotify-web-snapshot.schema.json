{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://korczis.github.io/sonic-playground/schema/spotify-web-snapshot.v1.json",
 "title": "A web-player snapshot (data/spotify/private/snapshots/web-<day>[-top].json)",
 "description": "What the owner's logged-in Spotify web player rendered on a day: the library, every playlist's rows, the profile's top lists. Read off the page, never through the session's credentials (ADR 0007). Private: it holds the date-added cells and the owner's identifiers.",
 "type": "object",
 "required": [
  "schema",
  "captured",
  "source",
  "library",
  "playlists"
 ],
 "$defs": {
  "row": {
   "type": "object",
   "description": "One rendered row: position, the link texts and ids, the date-added cell and the duration. Nullable fields carry no type.",
   "required": [
    "n"
   ],
   "properties": {
    "n": {
     "type": "integer"
    },
    "title": {},
    "track_id": {},
    "episode_id": {},
    "artists": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string"
       },
       "id": {}
      }
     }
    },
    "explicit": {
     "type": "boolean"
    },
    "album": {},
    "added": {},
    "duration": {},
    "unavailable": {
     "type": "boolean"
    },
    "text": {
     "type": "string"
    }
   }
  }
 },
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "spotify-web-snapshot/v1"
   ]
  },
  "captured": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "source": {
   "type": "string",
   "minLength": 10
  },
  "library": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "i": {
      "type": "integer"
     },
     "uri": {},
     "name": {},
     "sub": {}
    },
    "description": "A row of the library grid; an empty slot has no name."
   }
  },
  "playlists": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "name",
     "items"
    ],
    "properties": {
     "uri": {},
     "name": {
      "type": "string"
     },
     "library_subtitle": {},
     "owner": {},
     "description": {},
     "expected": {
      "type": "integer"
     },
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/row"
      }
     }
    }
   }
  },
  "top": {
   "type": "object",
   "required": [
    "range",
    "tracks",
    "artists"
   ],
   "properties": {
    "range": {
     "type": "string",
     "enum": [
      "short_term",
      "medium_term",
      "long_term"
     ]
    },
    "label": {
     "type": "string"
    },
    "tracks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/row"
     }
    },
    "artists": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "rank",
       "name"
      ],
      "properties": {
       "rank": {
        "type": "integer"
       },
       "name": {
        "type": "string"
       },
       "id": {}
      }
     }
    }
   }
  }
 }
}
