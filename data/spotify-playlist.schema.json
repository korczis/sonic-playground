{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://korczis.github.io/sonic-playground/schema/spotify-playlist.v1.json",
 "title": "One playlist of the owner's Spotify library (data/spotify/playlists/<id>.md front matter)",
 "description": "A playlist as read: its kind, its items in order, each a track record id. No playlist id and no owner identifier (ADR 0007). Derived by scripts/spotify_history.py.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "id",
  "name",
  "kind",
  "retrieved",
  "read",
  "tracks"
 ],
 "properties": {
  "schema": {
   "type": "string",
   "enum": [
    "spotify-playlist/v1"
   ]
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]*$"
  },
  "name": {
   "type": "string"
  },
  "kind": {
   "type": "string",
   "enum": [
    "liked",
    "own",
    "yearbook",
    "made-for-you",
    "followed"
   ]
  },
  "year": {
   "type": "integer",
   "description": "A yearbook's listening year."
  },
  "curator": {
   "type": "string",
   "enum": [
    "Spotify"
   ]
  },
  "description": {
   "type": "string"
  },
  "expected": {
   "type": "integer"
  },
  "retrieved": {
   "type": "integer"
  },
  "unavailable": {
   "type": "integer"
  },
  "read": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "tracks": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "n"
    ],
    "properties": {
     "n": {
      "type": "integer"
     },
     "track": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
     },
     "unavailable": {
      "type": "boolean"
     }
    }
   }
  }
 }
}
